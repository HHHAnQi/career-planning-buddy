# Copy this file to .env. Never commit .env or put secrets in VITE_* variables.

# Application
APP_NAME=Career Planning Buddy
APP_ENV=development
APP_GIT_COMMIT=unknown
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
VITE_API_BASE_URL=http://localhost:8000

# PostgreSQL 16 + pgvector. Compose constructs the container DATABASE_URL from POSTGRES_*.
POSTGRES_DB=career_buddy
POSTGRES_USER=career_buddy
POSTGRES_PASSWORD=career_buddy_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://career_buddy:career_buddy_local@localhost:5432/career_buddy

# Authentication. Replace the placeholder outside local development.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
JWT_ISSUER=career-planning-buddy

# Agent runtime
AGENT_GRAPH_VERSION=stage6b-v1
AGENT_FEATURE_STAGE=6
AGENT_MAX_LLM_CALLS=7
AGENT_MAX_TOOL_ROUNDS=2
AGENT_MAX_TOOL_CALLS=4
AGENT_MAX_TOTAL_TOKENS=16000
AGENT_MAX_INPUT_TOKENS_PER_CALL=6000
AGENT_MAX_OUTPUT_TOKENS_PER_CALL=1500
AGENT_DEADLINE_SECONDS=45
AGENT_POLL_INTERVAL_SECONDS=0.05
AGENT_HEARTBEAT_SECONDS=15
AGENT_LEASE_SECONDS=45
AGENT_MAX_RUN_ATTEMPTS=3
AGENT_WORKER_CONCURRENCY=2

# HTTP boundary guard: requests per minute per identity (0 disables limiting).
RATE_LIMIT_PER_MINUTE=120
TOOL_TIMEOUT_SECONDS=8

# LLM transport: mock | openai_compatible. Provider name controls capability mapping.
LLM_PROVIDER=mock
LLM_PROVIDER_NAME=auto
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_PLANNING_MODEL=
LLM_GOAL_UNDERSTANDING_MODEL=
LLM_EVIDENCE_DISTILLATION_MODEL=
LLM_PLANNING_REASONING=off
LLM_GOAL_UNDERSTANDING_REASONING=off
LLM_EVIDENCE_DISTILLATION_REASONING=off
LLM_TIMEOUT_SECONDS=90
# Wire-level SSE streaming for openai_compatible LLM calls (progress events
# and first-token latency; response semantics unchanged). Mock never streams.
LLM_STREAMING_ENABLED=false

# Single-answer speech recognition: mock | openai_compatible
ASR_PROVIDER=mock
ASR_API_KEY=
ASR_BASE_URL=
ASR_MODEL=whisper-1
ASR_TIMEOUT_SECONDS=30
ASR_MAX_AUDIO_BYTES=5000000
ASR_MAX_DURATION_SECONDS=120

# Pairwise Judge: mock | fixture | openai_compatible
JUDGE_LLM_PROVIDER=fixture
JUDGE_LLM_API_KEY=
JUDGE_LLM_BASE_URL=
JUDGE_LLM_MODEL=
JUDGE_LLM_TIMEOUT_SECONDS=60
JUDGE_LLM_MAX_OUTPUT_TOKENS=4096
JUDGE_LLM_TEMPERATURE=0

# Search: mock | baidu
SEARCH_PROVIDER=mock
BAIDU_SEARCH_API_KEY=
BAIDU_SEARCH_BASE_URL=https://qianfan.baidubce.com/v2/ai_search/web_search
BAIDU_SEARCH_EDITION=lite
BAIDU_SEARCH_MAX_RESULTS=5
BAIDU_SEARCH_TIMEOUT_SECONDS=10

# Embedding: mock | local | openai_compatible. EMBEDDING_DIM is fixed by the pgvector migration.
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL_PATH=
# openai_compatible hosted embedding (e.g. Zhipu embedding-3 at bigmodel).
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_API_MODEL=
EMBEDDING_MODEL_NAME=
EMBEDDING_MODEL_HOST_PATH=
EMBEDDING_DIM=1024

# Memory and RAG
MEMORY_SEMANTIC_RETRIEVAL_ENABLED=true
# Counterfactual ablation switch: true empties the L2 Personal memory
# layer (planning catalog AND the memory_lookup tool) for experiments.
MEMORY_DISABLED=false
MEMORY_RETRIEVAL_LIMIT=8
MEMORY_CONTEXT_MAX_ITEMS=5
MEMORY_CONTEXT_MAX_CHARS=1200
MEMORY_MIN_SIMILARITY=0.35
MEMORY_RECENCY_HALF_LIFE_DAYS=14
RAG_MIN_SIMILARITY=0.35
# Second-stage reranker for document retrieval: mock | tei
# tei targets a HuggingFace text-embeddings-inference /rerank endpoint
# (e.g. a local bge-reranker service publishing /rerank).
RERANK_PROVIDER=mock
RERANK_BASE_URL=
RERANK_TIMEOUT_SECONDS=8
# Chunks below this rerank score are dropped (answerability gate).
RAG_MIN_RERANK_SCORE=0.05

# Evaluation
EVAL_PROVIDER_MODE=mock
EVAL_AUDIT_LIVE_CALLS=true
EVAL_PROVIDER_SEED_MODE=provider_seed
EVAL_LIVE_MAX_ATTEMPTS=3
EVAL_LIVE_RETRY_BASE_SECONDS=1
EVAL_LIVE_RETRY_MAX_SECONDS=8
EVAL_TRIAL_CONCURRENCY=1
EVAL_LIVE_CONCURRENCY=2
EVAL_LIVE_PACING_SECONDS=0.5
EVAL_PAIR_SMOKE_PLANNING_PROFILE=

# Disable reasoning models hidden thinking (3-10x latency reduction)
LLM_DISABLE_THINKING=true
